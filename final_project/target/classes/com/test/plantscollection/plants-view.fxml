<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.test.plantscollection.PlantsController">
   <children>
      <VBox layoutX="1.0" layoutY="3.0">
         <VBox>
            <children>
               <Label text="Растение"/>
               <TextField fx:id="txtPlant"/>
               <Label text="Ядовитое"/>
               <ComboBox fx:id="harmfulComboBox"/>
               <HBox>
                  <children>
                     <Button mnemonicParsing="false" onAction="#onCreateButtonClick" text="Добавить" />
                     <Button mnemonicParsing="false" onAction="#onDeleteButtonClick" text="Удалить" />
                     <Button mnemonicParsing="false" onAction="#onUpdateButtonClick" text="Изменить"/>
                     <Button mnemonicParsing="false" onAction="#onPropertiesButtonClick" text="Свойства"/>
                  </children>
               </HBox>
            </children>
         </VBox>
         <TableView fx:id="tablePlants">
            <columns>
               <TableColumn fx:id="idCol" text="Id" prefWidth="150"/>
               <TableColumn fx:id="nameCol" text="Растение" prefWidth="150"/>
               <TableColumn fx:id="harmfulCol" text="Ядовитое" prefWidth="150"/>
            </columns>
         </TableView>
      </VBox>
   </children>
</AnchorPane>
