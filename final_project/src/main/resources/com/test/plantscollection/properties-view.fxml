<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.test.plantscollection.PropertiesController">
   <children>
      <HBox layoutX="1.0" layoutY="3.0">
         <children>
            <VBox>
               <children>
                  <Label text="Свойство"/>
                  <TextField fx:id="txtProperty"/>
                  <Button mnemonicParsing="false" onAction="#onAddButtonClick" text="Добавить" />
                  <Button mnemonicParsing="false" onAction="#onDeleteButtonClick" text="Удалить" />
               </children>
            </VBox>
            <TableView fx:id="tableProperty" prefWidth="300">
               <columns>
                  <TableColumn fx:id="textCol" text="Свойство" prefWidth="300"/>
               </columns>
            </TableView>
         </children>
      </HBox>
   </children>
</AnchorPane>
